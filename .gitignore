# Raw vendor data should not be committed, but the directory structure (.gitkeep) is kept
data/raw/fmp/*
data/raw/yahoo/*
data/raw/manual/*
!data/raw/fmp/.gitkeep
!data/raw/yahoo/.gitkeep
!data/raw/manual/.gitkeep

data/interim/fmp_clean/*
data/interim/yahoo_clean/*
data/interim/validation/*
!data/interim/fmp_clean/.gitkeep
!data/interim/yahoo_clean/.gitkeep
!data/interim/validation/.gitkeep

# Outputs are regenerated by the pipeline
outputs/*
!outputs/.gitkeep
!outputs/figures/.gitkeep

