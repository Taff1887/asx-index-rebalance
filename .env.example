# Financial Modeling Prep API key (https://site.financialmodelingprep.com/)
FMP_API_KEY=

# Primary and secondary data source identifiers.
# Loaders are routed in this order; the other source is used for cross-validation.
DATA_SOURCE_PRIMARY=fmp
DATA_SOURCE_SECONDARY=yahoo

# Benchmark ticker used for buy-and-hold ASX 200 comparison.
# STW.AX (SPDR S&P/ASX 200), IOZ.AX (iShares Core S&P/ASX 200), A200.AX (Betashares A200) are valid choices.
BENCHMARK_TICKER=STW.AX

# Optional: limit FMP request volume during local development.
FMP_DAILY_REQUEST_CAP=250
